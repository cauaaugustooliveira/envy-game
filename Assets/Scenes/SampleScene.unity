--- !u!114 &1047492896
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1047492893}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4f5baa72ee698df4b89fd08670c83d98, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueManager: {fileID: 151887200}
  dialogueLines:
  - characterName: Subaru
    text: "Bom, aqui n\xF3s temos a biblioteca proibida."
    portrait: {fileID: 21300000, guid: eca4fe65caf4daf4ead7012031bb9854, type: 3}
  - characterName: Beatrice
    text: "\u201CTemos\u201D nada, eu diria."
    portrait: {fileID: 21300000, guid: 53ad7bc9ec6d9954fb8cc00558e46400, type: 3}
  - characterName: Subaru
    text: "Ah! E essa \xE9 a Beako. Ela mora aqui, l\xEA o dia inteiro e reclama
      de praticamente tudo que eu fa\xE7o."
    portrait: {fileID: 21300000, guid: e921b65c6ec030d41a41961f92cd345c, type: 3}
  - characterName: Beatrice
    text: "Betty n\xE3o \u201Cmora aqui\u201D. E com quem diabos voc\xEA est\xE1
      falando, eu diria?"
    portrait: {fileID: 21300000, guid: c64b416acde367c429fdc24784a7177c, type: 3}
  - characterName: Subaru
    text: Viu? Ela gosta de mim.
    portrait: {fileID: 21300000, guid: 61f00509985dbac408d3b6c832843550, type: 3}
  - characterName: Beatrice
    text: "Que interpreta\xE7\xE3o absurda."
    portrait: {fileID: 21300000, guid: 46193ea534f53f84086d9aff3612917d, type: 3}
  - characterName: Subaru
    text: "Relaxa. Depois de um tempo voc\xEA aprende a traduzir."
    portrait: {fileID: 21300000, guid: 37420478796bb204291353d0ced82c90, type: 3}
  - characterName: Beatrice
    text: "N\xE3o ensine coisas estranhas para essa \"pessoa\", eu diria."
    portrait: {fileID: 21300000, guid: 46193ea534f53f84086d9aff3612917d, type: 3}
  - characterName: Subaru
    text: "Quando ela diz \u201Csaia\u201D, significa \u201Cobrigada pela visita\u201D."
    portrait: {fileID: 21300000, guid: e921b65c6ec030d41a41961f92cd345c, type: 3}
  - characterName: Beatrice
    text: Ghrr...!
    portrait: {fileID: 21300000, guid: d26b46fde509efd48b1182ebf2951bbe, type: 3}
  - characterName: Beatrice
    text: Saia imediatamente, de fato!
    portrait: {fileID: 21300000, guid: 46193ea534f53f84086d9aff3612917d, type: 3}
  - characterName: Subaru
    text: Viu?
    portrait: {fileID: 21300000, guid: 61f00509985dbac408d3b6c832843550, type: 3}
  - characterName: Subaru
    text: Ah, outra coisa importante sobre a Beako!
    portrait: {fileID: 21300000, guid: eca4fe65caf4daf4ead7012031bb9854, type: 3}
  - characterName: Beatrice
    text: "N\xE3o chame a Betty por esse nome rid\xEDculo, eu diria!"
    portrait: {fileID: 21300000, guid: 46193ea534f53f84086d9aff3612917d, type: 3}
  - characterName: Subaru
    text: "Ela consegue fazer essa biblioteca aparecer atr\xE1s de v\xE1rias portas
      da mans\xE3o."
    portrait: {fileID: 21300000, guid: 2a10e99b48903e34b937951d1a44217f, type: 3}
  - characterName: Beatrice
    text: "Betty n\xE3o faz isso para sua conveni\xEAncia, de fato."
    portrait: {fileID: 21300000, guid: c64b416acde367c429fdc24784a7177c, type: 3}
  - characterName: Subaru
    text: "Eu sei. Mas ainda \xE9 muito legal."
    portrait: {fileID: 21300000, guid: 37420478796bb204291353d0ced82c90, type: 3}
  - characterName: Beatrice
    text: ...
    portrait: {fileID: 21300000, guid: 0300e3de682814f46913a8374db53911, type: 3}
  - characterName: Subaru
    text: Ela concordou.
    portrait: {fileID: 21300000, guid: 61f00509985dbac408d3b6c832843550, type: 3}
  - characterName: Beatrice
    text: "Betty n\xE3o disse absolutamente nada!"
    portrait: {fileID: 21300000, guid: d26b46fde509efd48b1182ebf2951bbe, type: 3}
  - characterName: Subaru
    text: "Beatrice... Voc\xEA realmente n\xE3o lembra de nada... n\xE3o \xE9?"
    portrait: {fileID: 1925021568565171350, guid: 9a6921dbf3cbfbf45b4501af09dc2c62, type: 3}
  - characterName: Beatrice
    text: "Do que diabos voc\xEA est\xE1 murmurando, eu diria?"
    portrait: {fileID: 21300000, guid: 53ad7bc9ec6d9954fb8cc00558e46400, type: 3}
  - characterName: Subaru
    text: "Nada n\xE3o, deixa pra l\xE1!"
    portrait: {fileID: 21300000, guid: e921b65c6ec030d41a41961f92cd345c, type: 3}
  dialogueFinished: 0
  background: {fileID: 21300000, guid: 9df8bc9d735c3ac45a4584fee889827f, type: 3}
  progression: {fileID: 725707850}
