  - characterName: Subaru
    text: Hum... Parece que tem algo me impedindo de passar...
    portrait: {fileID: 21300000, guid: 4bb22d279673acd4e83c647e27fa5161, type: 3}
  - characterName: Subaru
    text: Ah!
    portrait: {fileID: 21300000, guid: eca4fe65caf4daf4ead7012031bb9854, type: 3}
  - characterName: Subaru
    text: "Preciso achar a porta certa e encontrar o \"culpado\" por tr\xE1s disso."
    portrait: {fileID: 21300000, guid: 37420478796bb204291353d0ced82c90, type: 3}
  - characterName: Subaru
