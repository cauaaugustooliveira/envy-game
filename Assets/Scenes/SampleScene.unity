--- !u!114 &1060790708
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1060790706}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: df8a9de9259feeb44b7fb06ead608e72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MonologueTrigger
  dialogueManager: {fileID: 151887200}
  background: {fileID: 21300000, guid: e92bbf655d4cce34a80a8e91ab98c8c4, type: 3}
  monologueLines:
  - characterName: Subaru
    text: ...
    portrait: {fileID: 21300000, guid: 37420478796bb204291353d0ced82c90, type: 3}
  - characterName: Subaru
    text: ...?!
    portrait: {fileID: -665330575056980057, guid: e938fa3f9874f144097ab9b8a16af281, type: 3}
  - characterName: Subaru
    text: "Q-Qu\xEA?!"
    portrait: {fileID: -3116267614432528050, guid: 498c53dbce62bfe419d172ceced40748, type: 3}
  - characterName: Subaru
    text: "...Parece que eu finalmente n\xE3o estou mais sendo for\xE7ado a reagir
      \xE0 coisas de um site e manter minhas express\xF5es controladas..."
    portrait: {fileID: 21300000, guid: 4bb22d279673acd4e83c647e27fa5161, type: 3}
  - characterName: Subaru
    text: "...Espera, essa \xE9 mans\xE3o antiga...?"
    portrait: {fileID: -3325924540120897882, guid: 409b24f68ee584b4096da1263806229c, type: 3}
  - characterName: Subaru
    text: E-Eu voltei tanto assim...?
    portrait: {fileID: -5574107701923595916, guid: 9ccda35f2c6f616409b8b5109f42bb23, type: 3}
  - characterName: Subaru
    text: 'T-Todos os momentos q-que eu passei com meus amigos...? '
    portrait: {fileID: 7383421181832982231, guid: ee2f6bd3c12eafe459957ab9d9180bbb, type: 3}
  - characterName: Subaru
    text: Nunca... existiram?
    portrait: {fileID: 7383421181832982231, guid: ee2f6bd3c12eafe459957ab9d9180bbb, type: 3}
  - characterName: Subaru
    text: Beako! Emilia! Ram! Rem...!
    portrait: {fileID: -5574107701923595916, guid: 9ccda35f2c6f616409b8b5109f42bb23, type: 3}
  - characterName: Subaru
    text: "Tudo... J\xE1 era?"
    portrait: {fileID: 844031232769627116, guid: 36d0290429aa8bd47b78040ac610a298, type: 3}
  - characterName: Subaru
    text: "Voc\xEA... T\xE1 me ouvindo, n\xE9? Eu sei que voc\xEA est\xE1..."
    portrait: {fileID: 1925021568565171350, guid: 9a6921dbf3cbfbf45b4501af09dc2c62, type: 3}
  - characterName: Subaru
    text: "Pat\xE9tico, n\xE9...?"
    portrait: {fileID: 844031232769627116, guid: 36d0290429aa8bd47b78040ac610a298, type: 3}
  - characterName: Subaru
    text: "Parece que tudo foi em v\xE3o..."
    portrait: {fileID: 5548774907620552866, guid: abe15c4c2c04de54ca7305c0d8c3408f, type: 3}
  - characterName: Subaru
    text: O jeito... vai ser fazer tudo de novo, do zero.
    portrait: {fileID: 1925021568565171350, guid: 9a6921dbf3cbfbf45b4501af09dc2c62, type: 3}
  - characterName: Subaru
    text: "Vem comigo, vou te mostrar como as coisas s\xE3o aqui."
    portrait: {fileID: 21300000, guid: e921b65c6ec030d41a41961f92cd345c, type: 3}
